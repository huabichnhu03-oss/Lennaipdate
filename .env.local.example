# ──────────────────────────────────────────────────────────────────────────────
# Lenna Portfolio — Environment Variables
# Copy this file to .env.local and fill in the values.
# ──────────────────────────────────────────────────────────────────────────────

# Required — PostgreSQL connection string (Neon, Supabase, Vercel Postgres, etc.)
# Example: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Required — Password for the /admin panel (minimum 8 characters)
ADMIN_PASSWORD=

# Required — Secret for signing admin session tokens (minimum 32 characters, random string)
ADMIN_TOKEN_SECRET=

# Optional — Resend API key for sending contact-form emails
# Get one at https://resend.com — required only if you want email notifications
RESEND_API_KEY=

# Optional — Email address that receives contact form submissions
# Defaults to lenna.huawork@gmail.com if not set
CONTACT_TO_EMAIL=

# Optional for local dev, effectively required on Vercel — Cloudinary image storage
# All three vars must be set together to enable Cloudinary; if any is missing the
# upload will fail on Vercel (where the local filesystem is ephemeral).
# Get your credentials at https://cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
